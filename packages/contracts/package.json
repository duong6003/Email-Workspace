{
  "name": "@eow/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../contracts/openapi.yaml -o src/openapi.d.ts",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run generate && vitest run --passWithNoTests"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
