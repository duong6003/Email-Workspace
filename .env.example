NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000
DATABASE_URL=postgresql://eow:eow@localhost:5432/eow
REDIS_URL=redis://localhost:6379
# Host-run development (`pnpm dev`) talks to Mailpit through its published
# loopback port. Start it with `pnpm infra:up`, which enables the `dev` Compose
# profile Mailpit now sits behind.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.test
SESSION_SECRET=replace-with-at-least-32-random-bytes
SENDER_CREDENTIAL_KEY=replace-with-exactly-64-hex-characters
RUNTIME_PROFILE=worker
