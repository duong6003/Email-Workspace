{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://email-operations-workspace.local/schemas/agent-run-state.json",
  "title": "Autonomous agent run state",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "goal", "approval", "mode", "status", "nodes", "updatedAt"],
  "properties": {
    "runId": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "scope"],
      "properties": {
        "evidence": {"type": "string", "minLength": 1},
        "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exclusions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "mode": {"enum": ["direct", "loop", "graph", "schedule", "scheduled_graph"]},
    "status": {"enum": ["pending", "running", "waiting", "completed", "blocked", "cancelled", "failed"]},
    "currentNode": {"type": ["string", "null"]},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "schedule": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/schedule"}]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "blocker": {"type": ["string", "null"]},
    "updatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dependsOn", "status", "attempt", "maxAttempts", "successConditions", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "dependsOn": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["pending", "ready", "running", "verifying", "completed", "blocked", "failed", "skipped"]},
        "attempt": {"type": "integer", "minimum": 0},
        "maxAttempts": {"type": "integer", "minimum": 1},
        "successConditions": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "nextAction": {"type": ["string", "null"]},
        "failureClass": {"type": ["string", "null"]}
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "triggerType", "triggerValue", "timezone", "deadline", "idempotencyKey", "resumePayload"],
      "properties": {
        "nodeId": {"type": "string"},
        "triggerType": {"enum": ["at", "cron", "condition"]},
        "triggerValue": {"type": "string"},
        "timezone": {"type": "string"},
        "deadline": {"type": "string", "format": "date-time"},
        "idempotencyKey": {"type": "string"},
        "resumePayload": {"type": "object"}
      }
    }
  }
}
