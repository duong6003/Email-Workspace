COMPOSE_PROJECT_NAME=email-operations-workspace
EOW_HTTP_BIND=0.0.0.0
EOW_HTTP_PORT=8080
# Mailpit is the local development mail catcher and only starts under
# `--profile dev` (the `infra:*` and `deploy:*` scripts in package.json pass it).
# A production bring-up runs `docker compose --env-file .env up -d --build --wait`
# with no profile and never starts it, so these three do nothing there.
EOW_MAILPIT_BIND=127.0.0.1
EOW_MAILPIT_PORT=8025
EOW_MAILPIT_SMTP_PORT=1025
EOW_POSTGRES_DB=eow
EOW_POSTGRES_USER=eow
EOW_POSTGRES_PASSWORD=
EOW_POSTGRES_APP_PASSWORD=
EOW_POSTGRES_BIND=127.0.0.1
EOW_POSTGRES_PORT=55432
EOW_REDIS_PASSWORD=
EOW_REDIS_BIND=127.0.0.1
EOW_REDIS_PORT=56379
EOW_SESSION_SECRET=
EOW_SENDER_CREDENTIAL_KEY=
EOW_WEB_ORIGIN=http://localhost:8080
EOW_WORKER_CONCURRENCY=10
EOW_SCHEDULER_TICK_MS=60000
EOW_NOTIFICATION_RETENTION_DAYS=90
# REQUIRED. Compose fails at interpolation time if EOW_SMTP_HOST or
# EOW_SMTP_FROM is unset, so mail can never be silently swallowed by the dev
# catcher. The values below are the LOCAL DEVELOPMENT ones -- `mailpit` is
# reachable only inside the Compose network and only under `--profile dev`.
# Replace all three with the real provider host, port and a provider-verified
# sender before any deployment that sends to real recipients.
EOW_SMTP_HOST=mailpit
EOW_SMTP_PORT=1025
EOW_SMTP_FROM=no-reply@example.test
EOW_SMTP_CONNECTION_TIMEOUT_MS=10000
EOW_SMTP_GREETING_TIMEOUT_MS=10000

# ADR-043 asset storage. REQUIRED like the SMTP pair above: a defaulted password
# on the store that holds every tenant's uploaded images would let a deployment
# come up with a well-known credential and surface nothing.
EOW_MINIO_ROOT_USER=eow
EOW_MINIO_ROOT_PASSWORD=
EOW_MINIO_BIND=127.0.0.1
EOW_MINIO_PORT=59000
EOW_MINIO_CONSOLE_PORT=59001
# Optional, defaulted. The bucket is created by the minio-init one-shot.
EOW_ASSET_BUCKET=eow-assets
EOW_ASSET_REGION=us-east-1
EOW_SMTP_SOCKET_TIMEOUT_MS=30000
EOW_LOG_LEVEL=info
EOW_TIMEZONE=Etc/UTC
EOW_CAMPAIGN_AUDIENCE_LIMIT=100000
# M6-S3 (BR-HIS-003): at or below this row count, an export renders
# synchronously; above it, the worker processes it in the background.
EOW_EXPORT_INLINE_MAX_ROWS=500
# M6-S3 (BR-HIS-007): hours until a completed export's stored artifact expires.
EOW_EXPORT_ARTIFACT_TTL_HOURS=72
# M6-S4 (BR-HIS-006): default retention window, in days, for detailed message
# events of tenants with no PUT /retention-policy row of their own. Campaign
# summaries and snapshots are never purged.
EOW_HISTORY_EVENT_RETENTION_DAYS=365
# M5-S4 (BR-SEND-008): HMAC secret providers sign their delivery webhooks
# with (X-EOW-Signature: t=<unix>,v1=<hex hmac-sha256>). Unset -> the
# webhook endpoint POST /api/v1/webhooks/providers/{provider} returns 503
# and accepts nothing; set it only once a real provider is configured to
# call back to this deployment. At least 32 characters.
EOW_PROVIDER_WEBHOOK_SECRET=
# BR-SEND-013: internal service listeners; do not publish these ports.
EOW_API_METRICS_PORT=9464
EOW_WORKER_METRICS_PORT=9465
# Optional `--profile observability` Grafana exposure and required admin secret.
EOW_GRAFANA_BIND=127.0.0.1
EOW_GRAFANA_PORT=3001
EOW_GRAFANA_ADMIN_PASSWORD=
